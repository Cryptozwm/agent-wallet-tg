# Copy to ~/.config/agent-wallet-tg/env (chmod 600). Never commit the real file.
# 复制到 ~/.config/agent-wallet-tg/env（chmod 600）。真实文件不要提交到 Git。

# Token from @BotFather
TG_BOT_TOKEN=
# Leave empty at first: message the bot once and it replies with your ID, then fill it in and restart.
# 先留空：给机器人发一条消息，它会回你的 ID，填进来后重启。
TG_OWNER_ID=

# Interface language: en (English) or zh (简体中文)
BOT_LANG=en
# Times are shown in this UTC offset (8 = UTC+8)
TZ_OFFSET_HOURS=8

# Most BNB one wallet may spend in one action (buy amount, bid total, call value).
# Can only be changed here, never from Telegram.
MAX_BNB_PER_WALLET=0.1
SLIPPAGE=auto
# Token audit risk level at or above this is refused for buys (4 = HIGH).
BLOCK_RISK_LEVEL=4
# Buys into a pool smaller than this (USD) are blocked unless you tap "buy anyway"; 0 turns it off.
MIN_LIQUIDITY_USD=20000
CONFIRM_TTL_SECONDS=90

# Optional
# RPC_URL=https://bsc-dataseed.bnbchain.org
# BSCSCAN_API_KEY=          lets /fn read verified ABIs that Sourcify does not have
# BAW_BIN=/path/to/baw      only if `baw` is not on PATH
# CAST_BIN=/path/to/cast    only if `cast` is not on PATH
